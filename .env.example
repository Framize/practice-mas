# Copy this file to .env and fill in your key.
#   cp .env.example .env
#
# .env is listed in .gitignore, so it never leaves your machine.
# Never paste a real key into any file that is not .env.

OPENAI_API_KEY=sk-proj-your-key-goes-here

# Optional. Every agent uses this model unless its code says otherwise.
# gpt-5-nano is the cheapest option, which is what you want while learning.
OPENAI_DEFAULT_MODEL=gpt-5-nano
